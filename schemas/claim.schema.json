{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "unknown",
        "inferred",
        "source_supported",
        "independently_corroborated",
        "physically_observed",
        "physically_validated",
        "conflicted",
        "rejected"
      ]
    },
    "applicability": {
      "type": "object",
      "properties": {
        "controller": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "firmware": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "enum": [
            "usb",
            "bluetooth",
            "receiver",
            "source_only",
            "not_measured"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "controller",
        "revision",
        "firmware",
        "transport",
        "scope"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "experiments": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "conflicts_with": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "rejection_scope": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "statement",
    "status",
    "applicability",
    "sources",
    "experiments",
    "conflicts_with",
    "supersedes",
    "rejection_scope"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
